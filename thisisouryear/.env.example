# Copy this file to ".env" for local testing and fill in the values.
# The real values for the live site go in Netlify, not here.
# Never commit a file with a real key in it. ".env" is already ignored by git.
# Every value below is blank on purpose. The README says what each one does.

# Stripe secret key. Starts with sk_test_ while testing, sk_live_ when you go live.
STRIPE_SECRET_KEY=

# The address of the site, with no slash at the end.
# Leave empty until the domain is connected. The site works without it.
SITE_URL=

# Stripe webhook signing secret. Starts with whsec_. Without it, paid orders
# are not recorded on the site.
STRIPE_WEBHOOK_SECRET=

# The password for the /admin/ screen. Make it long (16 characters or more).
ADMIN_TOKEN=

# A Netlify build hook address. Lets the site rebuild itself once a day so the
# counters stay right.
BUILD_HOOK_URL=

# Order emails. Every paid order goes to ORDER_EMAIL_TO (the vendor) with a
# copy to ORDER_EMAIL_CC (you). Needs EMAIL_PROVIDER, RESEND_API_KEY and
# EMAIL_FROM below too.
ORDER_EMAIL_TO=
ORDER_EMAIL_CC=

# Marketing email. All of these must be filled in, and CAMPAIGNS_LIVE must be
# exactly "true", before any campaign email can go out. Leave blank to keep
# email off.
CAMPAIGNS_LIVE=
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_POSTAL_ADDRESS=
UNSUBSCRIBE_SECRET=
