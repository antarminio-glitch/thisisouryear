{
  "name": "thisisouryear",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:checkout": "npx netlify-cli dev",
    "check": "node scripts/check-data.mjs",
    "photos": "node scripts/fetch-garment-photos.mjs",
    "photos:models": "node scripts/fetch-garment-photos.mjs --models",
    "build": "node scripts/check-data.mjs && astro build",
    "test": "node --test \"tests/*.test.mjs\"",
    "preview": "astro preview",
    "test:site": "node --test \"tests/site/*.test.mjs\"",
    "verify": "npm run build && npm test && npm run test:site",
    "artwork": "node scripts/export-artwork.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "astro": "^7.3.8",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0"
  }
}
