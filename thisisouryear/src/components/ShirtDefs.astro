---
// Shared shading for every shirt on the page. Included once by the layout.
// The shading is only black and white at low opacity, so it works on top of
// any shirt color.
---

<svg class="shirt-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <linearGradient id="tee-form" gradientUnits="userSpaceOnUse" x1="138" y1="0" x2="462" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity=".26"></stop>
      <stop offset=".16" stop-color="#000" stop-opacity="0"></stop>
      <stop offset=".42" stop-color="#fff" stop-opacity=".09"></stop>
      <stop offset=".6" stop-color="#fff" stop-opacity=".04"></stop>
      <stop offset=".86" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#000" stop-opacity=".26"></stop>
    </linearGradient>
    <linearGradient id="tee-drop" gradientUnits="userSpaceOnUse" x1="0" y1="46" x2="0" y2="575">
      <stop offset="0" stop-color="#fff" stop-opacity=".1"></stop>
      <stop offset=".3" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset=".7" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#000" stop-opacity=".18"></stop>
    </linearGradient>
    <linearGradient id="tee-sleeve-l" gradientUnits="userSpaceOnUse" x1="60" y1="225" x2="150" y2="130">
      <stop offset="0" stop-color="#000" stop-opacity=".3"></stop>
      <stop offset=".55" stop-color="#000" stop-opacity=".06"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity=".1"></stop>
    </linearGradient>
    <linearGradient id="tee-sleeve-r" gradientUnits="userSpaceOnUse" x1="540" y1="225" x2="450" y2="130">
      <stop offset="0" stop-color="#000" stop-opacity=".3"></stop>
      <stop offset=".55" stop-color="#000" stop-opacity=".06"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity=".1"></stop>
    </linearGradient>
    <clipPath id="tee-clip">
      <path d="M238 46Q300 62 362 46L444 70Q462 75 474 88L572 190Q578 197 572 204L512 256Q505 261 499 254L458 208C462 330 465 460 462 560Q462 568 454 569Q300 580 146 569Q138 568 138 560C135 460 138 330 142 208L101 254Q95 261 88 256L28 204Q22 197 28 190L126 88Q138 75 156 70Z"></path>
    </clipPath>
  </defs>
</svg>
