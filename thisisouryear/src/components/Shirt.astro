---
// One garment preview, any colors. It recolors itself from four CSS variables:
//   --shirt, --line1, --line2, --outline
// Set them on this element or on anything that wraps it.
//
// Where a real photo of the blank exists (src/data/garment-photos.json, built
// by "npm run photos"), the photo is shown with the lettering printed on it.
// Otherwise it's the drawing in src/lib/garment.js, which the browser can
// also redraw when someone changes garment or design in the picker.
//
// With no city there is no shirt at all, only the prompt to pick one. A blank
// garment in nobody's colors would not stand for any city.
//
// A city with an "image" field in teams.json shows that picture instead of
// either: use it for a photo of the finished, printed shirt.
import { garmentSvg } from '../lib/garment.js';
import { photoFor, productIdFor } from '../lib/photos.js';
import catalog from '../data/catalog.json';
import photos from '../data/garment-photos.json';

const { team, label = '', decorative = false, style = 'tee', audience = 'adult', lines, class: className = '' } = Astro.props;
const useOwnPhoto = team?.image && style === 'tee' && audience === 'adult';
const photo = team ? photoFor(photos, productIdFor(catalog.products, style, audience), team.slug) : null;
---

{
  !team ? (
    <div class="stage-empty" role="status"><p>Pick your city to see it in your colors.</p></div>
  ) : useOwnPhoto ? (
    <img class:list={['shirt', 'shirt-photo', className]} src={team.image} alt={decorative ? '' : label} />
  ) : (
    <Fragment set:html={garmentSvg({ style, audience, lines, label, decorative, className, photo })} />
  )
}
