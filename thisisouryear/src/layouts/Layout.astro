---
import '../styles/global.css';
import ShirtDefs from '../components/ShirtDefs.astro';

const {
  title,
  description,
  theme = '', // CSS variables for a city page. Empty means the neutral look.
  themeColor = '#2b2d31',
  image = '/share.png', // social preview image
  imageAlt = 'This Is Our Year, in block lettering',
  canonicalPath = null, // defaults to this page's own address, without any ?choices
  noindex = false,
  structuredData = null,
} = Astro.props;

const SITE_NAME = 'This Is Our Year';
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const shareImage = new URL(image, Astro.site);

const nav = [
  ['/teams/', 'Cities'],
  ['/shop/', 'Shop'],
  ['/gifts/rival-colors/', 'Gifts'],
  ['/fantasy-leagues/', 'Leagues'],
  ['/matching-sets/', 'Sets'],
  ['/fans/', 'Fans'],
];
const here = Astro.url.pathname;

const footerLinks = [
  ['/teams/', 'All cities'],
  ['/bandwagon/', 'Bandwagon'],
  ['/size-chart/', 'Size chart'],
  ['/shipping-returns/', 'Shipping and returns'],
  ['/contact/', 'Contact'],
  ['/privacy/', 'Privacy'],
  ['/terms/', 'Terms'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/graduate.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-semi-condensed-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body style={theme}>
    <a class="skip" href="#main">Skip to content</a>
    <ShirtDefs />
    <header class="site-head">
      <div class="wrap head-row">
        <a class="brand" href="/">This Is Our Year</a>
        <a class="cart-link" href="/cart/" data-cart-link aria-label="Cart, empty">
          Cart<span class="cart-count" data-cart-count hidden></span>
        </a>
      </div>
      <nav class="site-nav" aria-label="Main">
        <ul class="wrap">
          {nav.map(([href, label]) => (
            <li><a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <ul>
          {footerLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
        <p class="legal">
          This Is Our Year is an independent brand. It is not affiliated with, licensed by, or endorsed by any
          professional football league or team.
        </p>
      </div>
    </footer>

    <script>
      import { wireCartBadges } from '../scripts/cart.js';
      wireCartBadges();
    </script>
  </body>
</html>
