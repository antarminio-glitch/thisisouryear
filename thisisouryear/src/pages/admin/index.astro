---
// The owner's screen. Not linked from anywhere, hidden from search engines,
// and useless without the admin password. The password is checked by the
// server on every single action, not by this page.
import Layout from '../../layouts/Layout.astro';
import ShopData from '../../components/ShopData.astro';
---

<Layout title="Admin" description="Owner controls for This Is Our Year." noindex>
  <ShopData />
  <div class="wrap page admin" data-admin>
    <h1>Admin</h1>

    <form class="gate" data-gate novalidate>
      <div class="field">
        <label for="admin-password">Admin password</label>
        <input id="admin-password" name="password" type="password" autocomplete="current-password" required />
        <p class="hint">The one you saved in Netlify as ADMIN_TOKEN. It's remembered until you close this tab.</p>
      </div>
      <p class="form-msg" data-gate-msg role="alert" hidden></p>
      <button class="btn" type="submit">Sign in</button>
    </form>

    <div data-app hidden>
      <nav class="tabs" aria-label="Admin sections">
        <button type="button" data-tab="setup">Setup</button>
        <button type="button" data-tab="orders">Orders</button>
        <button type="button" data-tab="season">Season</button>
        <button type="button" data-tab="campaigns">Campaigns</button>
        <button type="button" data-tab="quotes">Quotes</button>
        <button type="button" data-tab="fans">Fan photos</button>
        <button type="button" class="out" data-signout>Sign out</button>
      </nav>
      <div class="panel" data-panel></div>
    </div>
    <noscript><p>This screen needs JavaScript.</p></noscript>
  </div>
</Layout>

<script>
  import '../../scripts/admin.js';
</script>

<style is:global>
  .admin {
    max-width: 980px;
  }
  .admin .gate {
    max-width: 420px;
  }
  .admin .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 4px;
    margin-bottom: 28px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }
  .admin .tabs button {
    min-height: 44px;
    padding: 8px 14px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--soft);
    font: 600 1.0625rem/1.2 var(--body);
    cursor: pointer;
  }
  .admin .tabs button[aria-current='page'] {
    background: var(--panel);
    color: var(--on-bg);
    box-shadow: inset 0 0 0 1px var(--edge);
  }
  .admin .tabs .out {
    margin-left: auto;
    font-weight: 400;
    text-decoration: underline;
  }
  .admin .panel h2 {
    font-size: 1.5rem;
  }
  .admin .panel h3 {
    font-size: 1.1875rem;
    margin: 34px 0 10px;
  }
  .admin .sub {
    margin: 6px 0 14px;
    max-width: var(--read);
    color: var(--soft);
  }
  .admin .note {
    margin: 0 0 18px;
    padding: 12px 16px;
    border-radius: 6px;
    background: var(--panel);
    box-shadow: inset 3px 0 0 var(--on-bg);
    max-width: var(--read);
  }
  .admin .note.bad {
    box-shadow: inset 3px 0 0 #ffb4a8;
  }
  .admin .facts {
    margin: 0 0 8px;
    max-width: 760px;
    border-top: 1px solid var(--rule);
  }
  .admin .facts div {
    display: grid;
    gap: 2px 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .admin .facts dt {
    color: var(--soft);
  }
  .admin .facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .admin .plain,
  .admin .missing {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
    max-width: 760px;
  }
  .admin .plain li,
  .admin .missing li {
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
    overflow-wrap: anywhere;
  }
  .admin .missing li {
    display: grid;
    gap: 3px;
  }
  .admin code {
    font: 600 0.9375rem/1.4 ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }
  .admin .card {
    margin: 0 0 22px;
    padding: 18px 20px 20px;
    border-radius: 8px;
    background: var(--panel);
  }
  .admin .card h3 {
    margin-top: 0;
  }
  .admin .card .field input,
  .admin .card .field select,
  .admin .card .field textarea {
    background: var(--bg);
  }
  .admin .cols {
    display: grid;
    gap: 0 14px;
  }
  .admin .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 12px;
    align-items: end;
    max-width: 420px;
  }
  .admin .row .btn {
    margin-bottom: 20px;
  }
  .admin .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 4px 0 18px;
  }
  .admin .btns .btn {
    width: auto;
    min-height: 46px;
    padding: 10px 18px;
    font-size: 1.0625rem;
  }
  .admin .filters .btn[aria-pressed='true'] {
    background: var(--on-bg);
    color: var(--bg);
  }
  .admin .check {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 12px;
    align-items: start;
    margin: 0 0 16px;
    cursor: pointer;
  }
  .admin .check input {
    width: 24px;
    height: 24px;
    margin: 2px 0 0;
    accent-color: var(--on-bg);
  }
  .admin table.wide {
    max-width: none;
  }
  .admin pre {
    margin: 8px 0 0;
    padding: 14px;
    border-radius: 6px;
    background: var(--bg);
    font: 400 0.9375rem/1.5 ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .admin details {
    margin: 14px 0 0;
  }
  .admin summary {
    font-weight: 600;
    cursor: pointer;
    padding: 6px 0;
  }
  .admin .fan {
    display: grid;
    gap: 16px;
  }
  .admin .thumb img {
    display: block;
    width: 100%;
    max-width: 320px;
    border-radius: 6px;
  }
  @media (min-width: 720px) {
    .admin .facts div {
      grid-template-columns: 260px 1fr;
    }
    .admin .missing li {
      grid-template-columns: 300px 1fr;
      gap: 16px;
    }
    .admin .cols {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .admin .fan {
      grid-template-columns: 320px 1fr;
    }
  }
</style>
