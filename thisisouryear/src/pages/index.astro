---
import Layout from '../layouts/Layout.astro';
import Lettering from '../components/Lettering.astro';
import Picker from '../components/Picker.astro';
import CityGrid from '../components/CityGrid.astro';
import ShopData from '../components/ShopData.astro';
import ModelShot from '../components/ModelShot.astro';
import teams from '../data/teams.json';
import models from '../data/model-photos.json';
import photos from '../data/garment-photos.json';
import { shop } from '../lib/shop.js';
import { dollars, fromPriceCents } from '../lib/money.js';
import { cityForBlank, rotatingPick } from '../lib/photos.js';

const price = dollars(fromPriceCents());

// Two on-model shots for the hero, one tee and one hoodie, each worn in the
// colors of a city printed on that blank. They rotate with the daily rebuild.
const heroShot = (productId) => {
  const options = Object.values(models.photos).filter((m) => m.productId === productId);
  const photo = rotatingPick(options);
  const team = photo ? cityForBlank(photos, teams, productId, photo.color) : null;
  return photo && team ? { photo, team, garment: shop.product(productId)?.name ?? '' } : null;
};
const heroShots = [heroShot('adult-tee'), heroShot('adult-hoodie')].filter(Boolean);
// "S through 3XL" for adults, plus "XS through XL for kids" once a kids garment is for sale.
const sizesOf = (id) => shop.product(id).variants.map((v) => v.size);
const adultSizes = sizesOf('adult-tee');
const kidsProduct = ['kids-tee', 'kids-hoodie'].find((id) => shop.isSellable(shop.product(id)));
const kidsSizes = kidsProduct ? sizesOf(kidsProduct) : [];
const sizeLine = kidsSizes.length
  ? `Adults ${adultSizes[0]} through ${adultSizes.at(-1)}, kids ${kidsSizes[0]} through ${kidsSizes.at(-1)}.`
  : `${adultSizes[0]} through ${adultSizes.at(-1)}.`;
const status = (id) => (shop.isSellable(shop.product(id)) ? `From ${dollars(shop.priceRange(id).lowCents)}` : 'Preview only for now');

// The ways in. Each one says plainly whether it can be bought yet.
const ways = [
  { href: '/shop/?style=tee', title: 'Tees', note: status('adult-tee'), line: 'The original. Printed when you order.' },
  { href: '/shop/?style=hoodie', title: 'Hoodies', note: status('adult-hoodie'), line: 'For the cold-weather faithful.' },
  { href: '/shop/?fit=kids', title: 'Kids', note: status('kids-tee'), line: 'Start them early. They have decades of hope ahead.' },
  { href: '/matching-sets/', title: 'Matching sets', note: 'One adult, one kid', line: 'Same colors, different sizes.' },
  { href: '/fantasy-leagues/', title: 'Fantasy leagues', note: shop.bulkTiers.length ? `Up to ${Math.max(...shop.bulkTiers.map((t) => t.percentOff))}% off` : 'Mixed sizes', line: 'Last place. Wrong colors.' },
  { href: '/gifts/rival-colors/', title: 'Rival gifts', note: 'You choose what they wear', line: 'A thoughtful gift. For a terrible friend.' },
];
---

<Layout theme="--bg: #15191d; --on-bg: #ffffff; --soft: #c5d1c7;" themeColor="#15191d" description={`Every fan says it every season. Now wear it in your city's colors. One design, ${teams.length} colorways, tees from ${price}.`}>
  <ShopData />

  <section class="hero">
    <div class="wrap">
      <p class="campaign" data-campaign role="status" hidden></p>
      <p class="hero-kicker">{teams.length} cities · One shirt · From {price}</p>
      <h1>
        <span class="sr-only">This Is Our Year</span>
        <svg class="hero-letters" viewBox="0 0 620 232" aria-hidden="true">
          <Lettering x={310} y={91} size={100} />
        </svg>
      </h1>
      <p class="hero-line">
        <span>Every year. Our year.</span>
        <span>Your colors. Your annual declaration of unreasonable optimism.</span>
      </p>
      <div class="hero-actions">
        <a class="btn" href="#find">Find my colors</a>
        <a class="btn btn-quiet" href="/gifts/rival-colors/">Make it someone else's problem</a>
      </div>
      {
        heroShots.length > 0 && (
          <div class="hero-models">
            {heroShots.map((s) => (
              <ModelShot photo={s.photo} team={s.team} label={`${s.garment} in ${s.team.name} colors, on a model`} caption={`${s.team.name} ${s.garment.toLowerCase()}`} />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="find" id="find">
    <div class="wrap">
      <Picker id="home" heading="Find my colors" />
    </div>
  </section>

  <section class="ways" aria-labelledby="ways-h">
    <div class="wrap">
      <h2 id="ways-h">Ways to shop</h2>
      <ul>
        {
          ways.map((w) => (
            <li>
              <a href={w.href}>{w.title}</a>
              <span class="note">{w.note}</span>
              <p>{w.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="cities" id="cities" aria-labelledby="cities-h">
    <div class="wrap">
      <h2 id="cities-h">{teams.length} cities. One design. Tees from {price}.</h2>
      <CityGrid id="cities" />
    </div>
  </section>

  <section class="fans" aria-labelledby="fans-h" data-fan-strip hidden>
    <div class="wrap">
      <h2 id="fans-h">Fans who said it out loud</h2>
      <ul class="fan-row" data-fan-list></ul>
      <p><a href="/fans/">See more, or send yours</a></p>
    </div>
  </section>

  <section class="how" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h">How it works</h2>
      <ol>
        <li>
          <h3>Pick your city</h3>
          <p>Same shirt, same four words, your colors.</p>
        </li>
        <li>
          <h3>Pick your size</h3>
          <p>{sizeLine} Checkout takes about a minute.</p>
        </li>
        <li>
          <h3>We print and ship</h3>
          <p>Printed when you order and mailed to your door, in plenty of time to be wrong again.</p>
        </li>
      </ol>
    </div>
  </section>
</Layout>

<script>
  import { loadPublicState, loadFanPhotos, renderFanList } from '../scripts/live.js';

  // A campaign message only shows when a campaign has been switched on.
  loadPublicState().then((state) => {
    const el = document.querySelector<HTMLElement>('[data-campaign]');
    if (!el) return;
    if (state?.campaign?.heroLine) {
      el.textContent = `${state.campaign.heroTitle} ${state.campaign.heroLine}`;
      el.hidden = false;
    } else if (state?.bandwagon?.verified && state.bandwagon.slugs?.length) {
      // Playoff time, and the picture is confirmed: point at the survivors.
      const n = state.bandwagon.slugs.length;
      const link = document.createElement('a');
      link.href = '/bandwagon/';
      link.textContent = 'Pick a survivor';
      el.textContent = `Still alive: ${n} ${n === 1 ? 'city' : 'cities'}. Room on the bandwagon. `;
      el.append(link);
      el.hidden = false;
    }
  });

  // Approved fan photos, if there are any yet.
  loadFanPhotos(6).then((photos) => {
    const strip = document.querySelector<HTMLElement>('[data-fan-strip]');
    const list = document.querySelector<HTMLElement>('[data-fan-list]');
    if (strip && list && photos.length) {
      renderFanList(list, photos);
      strip.hidden = false;
    }
  });
</script>

<style>
  .hero {
    padding-block: 38px 48px;
    text-align: center;
    /* The lettering takes these the same way a city page's shirt does. */
    --shirt: #082d18;
    --border: #082d18;
    --line1: #ffffff;
    --line2: #f5bd00;
    --outline: #082d18;
    background:
      linear-gradient(180deg, transparent, #062b18e6),
      repeating-linear-gradient(90deg, #ffffff09 0 10%, #ffffff00 10% 20%),
      linear-gradient(125deg, #307849, #165c32);
    border-top: 1px solid #ffffff12;
  }
  :global(body:has(.hero) .site-head) {
    border-top: 4px solid #f5bd00;
  }
  .hero-kicker {
    margin: 0 0 16px;
    color: #ffd02e;
    font: 400 clamp(0.875rem, 2vw, 1.125rem) / 1.5 var(--display);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .hero-actions .btn {
    min-height: 56px;
    background: #f5bd00;
    color: #092619;
    border-color: #f5bd00;
  }
  .hero-actions .btn:hover {
    background: #ffcf32;
  }
  .hero-actions .btn-quiet {
    background: transparent;
    color: #fff;
    border-color: #9ab69e;
  }
  .hero-actions .btn-quiet:hover {
    background: #ffffff12;
  }
  .hero-actions a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }
  @media (max-width: 440px) {
    .hero-kicker {
      font-size: 0.8125rem;
      letter-spacing: 0.08em;
    }
  }
  .campaign {
    display: inline-block;
    margin: 0 auto 22px;
    padding: 8px 14px;
    border-radius: 4px;
    background: var(--on-bg);
    color: var(--bg);
    font-weight: 600;
  }
  .campaign[hidden] {
    display: none;
  }
  .hero h1 {
    margin: 0 auto;
    max-width: 640px;
  }
  .hero-letters {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero-line {
    margin: 18px auto 26px;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--soft);
  }
  .hero-line span {
    display: block;
    text-wrap: balance;
  }
  .hero-line span:first-child {
    color: var(--on-bg);
    font-weight: 600;
  }
  .hero-actions {
    display: grid;
    gap: 10px;
    max-width: 420px;
    margin-inline: auto;
  }

  .find {
    padding-block: 36px 8px;
    scroll-margin-top: 8px;
    border-top: 1px solid var(--rule);
  }

  .ways {
    margin-top: 48px;
    padding-block: 40px;
    background: color-mix(in srgb, #000 22%, var(--bg));
  }
  .ways h2,
  .cities h2,
  .fans h2,
  .how h2 {
    font-size: clamp(1.375rem, 5.4vw, 2rem);
    margin-bottom: 22px;
  }
  .ways ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .ways li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 14px;
    align-items: baseline;
    padding: 14px 16px;
    border-bottom: 1px solid var(--rule);
    border-left: 3px solid #f5bd00;
  }
  .ways li:nth-child(3n + 2) {
    border-left-color: #55b5de;
  }
  .ways li:nth-child(3n) {
    border-left-color: #b7a1e4;
  }
  .ways a {
    font-weight: 600;
    font-size: 1.25rem;
  }
  .ways .note {
    font-size: 0.9375rem;
    color: var(--soft);
    text-align: right;
  }
  .ways p {
    grid-column: 1 / -1;
    color: var(--soft);
  }

  .cities {
    padding-block: 48px 0;
    scroll-margin-top: 8px;
  }

  .fans {
    padding-block: 48px 0;
  }
  .fans[hidden] {
    display: none;
  }

  .how {
    margin-top: 64px;
    padding-block: 44px;
    background: color-mix(in srgb, #000 22%, var(--bg));
  }
  .how ol {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 26px;
  }
  .how li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 44px 1fr;
    column-gap: 14px;
    align-items: start;
  }
  .how li::before {
    color: #f5bd00;
    content: counter(step);
    grid-row: span 2;
    font: 400 2.5rem/1 var(--display);
  }
  .how h3 {
    font: 600 1.25rem/1.25 var(--body);
  }
  .how p {
    color: var(--soft);
  }

  @media (min-width: 720px) {
    .hero {
      padding-block: 52px 64px;
    }
    .hero-line {
      font-size: 1.375rem;
    }
    .hero-actions {
      grid-template-columns: 1fr 1fr;
      max-width: 620px;
    }
    .ways ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 32px;
      border-top: 0;
    }
    .ways li {
      border-top: 1px solid var(--rule);
      border-bottom: 0;
      align-content: start;
    }
    .how ol {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
</style>
