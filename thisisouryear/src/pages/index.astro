---
import Layout from '../layouts/Layout.astro';
import Lettering from '../components/Lettering.astro';
import Picker from '../components/Picker.astro';
import CityGrid from '../components/CityGrid.astro';
import ShopData from '../components/ShopData.astro';
import ModelShot from '../components/ModelShot.astro';
import Shirt from '../components/Shirt.astro';
import { shirtVars } from '../lib/cities.js';
import { styleString } from '../lib/colors.js';
import teams from '../data/teams.json';
import models from '../data/model-photos.json';
import photos from '../data/garment-photos.json';
import { cityForBlank, rotatingPick } from '../lib/photos.js';
import { shop } from '../lib/shop.js';
import { dollars, fromPriceCents } from '../lib/money.js';

const price = dollars(fromPriceCents());
const dallas = teams.find((t) => t.slug === 'dallas');

// Two on-model shots lower on the page, one tee and one hoodie, each worn in the
// colors of a city printed on that blank. They rotate with the daily rebuild.
const wearShot = (productId) => {
  const options = Object.values(models.photos).filter((m) => m.productId === productId);
  const photo = rotatingPick(options);
  const team = photo ? cityForBlank(photos, teams, productId, photo.color) : null;
  return photo && team ? { photo, team, garment: shop.product(productId)?.name ?? '' } : null;
};
const wearShots = [wearShot('adult-tee'), wearShot('adult-hoodie')].filter(Boolean);
// "S through 3XL" for adults, plus "XS through XL for kids" once a kids garment is for sale.
const sizesOf = (id) => shop.product(id).variants.map((v) => v.size);
const adultSizes = sizesOf('adult-tee');
const kidsProduct = ['kids-tee', 'kids-hoodie'].find((id) => shop.isSellable(shop.product(id)));
const kidsSizes = kidsProduct ? sizesOf(kidsProduct) : [];
const sizeLine = kidsSizes.length
  ? `Adults ${adultSizes[0]} through ${adultSizes.at(-1)}, kids ${kidsSizes[0]} through ${kidsSizes.at(-1)}.`
  : `${adultSizes[0]} through ${adultSizes.at(-1)}.`;
// A taste of the colorways before the full wall of 32: six cities whose colors read well side by side.
const featured = ['dallas', 'green-bay', 'buffalo', 'kansas-city', 'baltimore', 'miami'].map((slug) => teams.find((t) => t.slug === slug)).filter(Boolean);
const teeRange = shop.priceRange('adult-tee');
const teePrice = teeRange ? dollars(teeRange.lowCents) : null;
const ways = [
  { href: '/matching-sets/', title: 'Raise them right', note: 'Matching adult + kid sets', line: 'Same colors. Same unreasonable optimism.' },
  { href: '/fantasy-leagues/', title: 'Last place wears it', note: 'Fantasy punishment', line: shop.bulkTiers.length ? `Put the loser in rival colors. Bulk orders up to ${Math.max(...shop.bulkTiers.map((t) => t.percentOff))}% off.` : 'Put the loser in rival colors. Build your league order.' },
  { href: '/gifts/rival-colors/', title: 'Give them the wrong colors', note: 'Rival gifts', line: 'A thoughtful gift. For a terrible friend.' },
  { href: '/bandwagon/', title: 'New city. Same confidence.', note: 'The bandwagon', line: 'Looking for a team to back? Find your next colors.' },
];
---

<Layout theme="--bg: #15171a; --on-bg: #ffffff; --soft: #bfc4cb;" themeColor="#15171a" description={`Every fan says it every season. Now wear it in your city's colors. One design, ${teams.length} colorways, tees from ${price}.`}>
  <ShopData />

  <section class="hero">
    <div class="wrap hero-layout">
      <div class="hero-copy">
        <p class="campaign" data-campaign role="status" hidden></p>
        <p class="eyebrow">2026 NFL season · {teams.length} cities · One belief</p>
        <h1><span class="sr-only">This Is Our Year</span><svg class="hero-letters" viewBox="75 0 470 232" aria-hidden="true"><Lettering /></svg></h1>
        <p class="hero-tagline">2026. This is <em>OUR</em> year.</p>
        <p class="hero-description">New season. Same unshakable belief. Wear your colors like you mean it.</p>
        <div class="hero-actions">
          <a class="btn" href="#find">Find my colors <span aria-hidden="true">↗</span></a>
          <a class="hero-link" href="/shop/">Shop all styles →</a>
        </div>
        <p class="hero-details">Tees from {price} <span aria-hidden="true">·</span> Adult &amp; kids <span aria-hidden="true">·</span> Printed to order</p>
      </div>
      <div class="hero-product">
        <div class="product-heading"><span>2026 season collection</span><span>Dallas / Navy &amp; silver</span></div>
        <a class="dallas-feature" href="#find"><img src={dallas.image} width="1408" height="768" alt="Dallas navy This Is Our Year shirt with white and silver lettering" fetchpriority="high" /></a>
        <div class="product-caption"><div><strong>Big expectations. Dallas colors.</strong><span>Navy. Silver. All-in optimism.</span></div><a href="#find">Make it yours ↗</a></div>
        <p class="mockup-note">Product mockup. Final print colors and placement may vary.</p>
      </div>
    </div>
  </section>
  <div class="season-strip"><div class="wrap"><span>2026: OUR YEAR. OUR COLORS. OUR SUNDAYS.</span><a href="#cities">Explore all {teams.length} cities →</a></div></div>
  <section class="find" id="find">
    <div class="wrap">
      <div class="find-intro"><p class="eyebrow">Your 2026 game-day uniform</p><h2>Start with Dallas. Make it your city.</h2><p>Dallas is showing now. Choose any city or switch to a hoodie to see your own colorway.</p></div>
      <Picker id="home" city={dallas} defaultCity={dallas} heading="Find my colors" />
    </div>
  </section>
  <section class="season-hype" aria-labelledby="season-h">
    <div class="wrap"><p class="eyebrow">The 2026 belief department</p><h2 id="season-h">The standings change.<br />The belief doesn't.</h2><div class="slogan-grid"><p>New season.<br /><strong>Same big talk.</strong></p><p>Sunday plans?<br /><strong>Wear the belief.</strong></p><p>Say it louder.<br /><strong>THIS IS OUR YEAR.</strong></p></div><a href="#find">Put your prediction on a shirt ↗</a></div>
  </section>
  <section class="team-story wrap" aria-labelledby="history-h" data-history-panel>
    <div class="section-heading"><div><p class="eyebrow">Know the history. Wear the hope.</p><h2 id="history-h" data-history-title>Dallas Cowboys: a tradition of belief.</h2></div><span class="season-badge">2026 · OUR YEAR</span></div>
    <div class="history-layout"><div><p class="history-copy" data-history-copy>Dallas joined the NFL in 1960. Tom Landry's teams put together 20 consecutive winning seasons beginning in 1966. Five Super Bowl title seasons later, the next chapter is still the one fans want to write.</p><p class="history-source" data-history-source><a href="https://www.profootballhof.com/teams/dallas-cowboys">History source: Pro Football Hall of Fame ↗</a></p></div><dl class="history-stats" data-history-stats><div><dt>First season</dt><dd>1960</dd></div><div><dt>Super Bowl titles</dt><dd>5</dd></div><div><dt>Title seasons</dt><dd class="title-years">1971 · 1977 · 1992 · 1993 · 1995</dd></div></dl></div>
    <p class="history-slogan" data-history-slogan>Five titles in the history books. One more reason to say: this is OUR year.</p>
  </section>
  <section class="game-day wrap" aria-labelledby="tips-h"><div class="section-heading"><div><p class="eyebrow">Before the next kickoff</p><h2 id="tips-h">Your game-day playbook.</h2></div></div><ol><li><strong>Check the fit.</strong><p>Use the garment's size chart before ordering. Tee and hoodie sizing can differ.</p></li><li><strong>Check the forecast.</strong><p>Tee for the watch party. Hoodie for the cold-weather tailgate. Same belief, different layer.</p></li><li><strong>Bring the rivalry.</strong><p>Build a matching set or choose a rival's colors for a friend who talks too much.</p><a href="/gifts/rival-colors/">Build a rival gift →</a></li></ol></section>
  <section class="ways" id="ways" aria-labelledby="ways-h">
    <div class="wrap">
      <h2 id="ways-h">More ways to say it</h2>
      <ul>
        {
          ways.map((w) => (
            <li>
              <a href={w.href}><span class="note">{w.note}</span><span class="way-title">{w.title}</span><span class="way-line">{w.line}</span><span class="way-go" aria-hidden="true">Shop this way →</span></a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="cities" id="cities" aria-labelledby="cities-h">
    <div class="wrap">
      <h2 id="featured-h">{teams.length} cities. One design.</h2>
      <ul class="featured" aria-labelledby="featured-h">
        {
          featured.map((t) => (
            <li>
              <a href={`/${t.slug}/`} style={styleString(shirtVars(t))}>
                <span class="tile"><Shirt team={t} decorative /></span>
                <span class="city">{t.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <details>
        <summary id="cities-h">Browse all {teams.length} cities <span>See every colorway</span></summary>
        <CityGrid id="cities" />
      </details>
    </div>
  </section>

  <section class="worn" aria-labelledby="worn-h">
    <div class="wrap">
      <h2 id="worn-h">How it looks on</h2>
      {
        wearShots.length > 0 && (
          <div class="hero-models">
            {wearShots.map((s) => (
              <ModelShot photo={s.photo} team={s.team} label={`${s.garment} in ${s.team.name} colors, on a model`} caption={`${s.team.name} ${s.garment.toLowerCase()}`} />
            ))}
          </div>
        )
      }
      <p class="concept">Model mockups: the design is placed digitally on a photo of the blank garment.</p>
      <p class="worn-link"><a href="#find">Find yours in your city’s colors →</a></p>
    </div>
  </section>

  <section class="fans" aria-labelledby="fans-h" data-fan-strip hidden>
    <div class="wrap">
      <h2 id="fans-h">Fans who said it out loud</h2>
      <ul class="fan-row" data-fan-list></ul>
      <p><a href="/fans/">See more, or send yours</a></p>
    </div>
  </section>

  <section class="how" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h">How it works</h2>
      <ol>
        <li>
          <h3>Pick your city</h3>
          <p>Same shirt, same four words, your colors.</p>
        </li>
        <li>
          <h3>Pick your size</h3>
          <p>{sizeLine} Check the size chart for your fit.</p>
        </li>
        <li>
          <h3>We print and ship</h3>
          <p>Printed when you order and mailed to your door. <a href="/shipping-returns/">Shipping details</a>.</p>
        </li>
      </ol>
    </div>
  </section>
</Layout>

<script>
  import { loadPublicState, loadFanPhotos, renderFanList } from '../scripts/live.js';

  import seasonHistory from '../data/history.json';
  import stories from '../data/stories.json';
  import { cityBySlug } from '../scripts/shop-data.js';
  const homePicker = document.querySelector<HTMLElement>('[data-picker][data-group="home"]');
  const historyPanel = document.querySelector<HTMLElement>('[data-history-panel]');
  const originalHistory = historyPanel?.innerHTML ?? '';
  function updateHistory(slug: string) {
    if (!historyPanel) return;
    if (slug === 'dallas') { historyPanel.innerHTML = originalHistory; return; }
    const city = cityBySlug(slug);
    if (!city) return;
    const story = (stories as Record<string, { story: string }>)[slug];
    const record = (seasonHistory.cities as Record<string, {state: string; lastWinSeason: number | null; verified: boolean}>)[slug];
    historyPanel.innerHTML = originalHistory;
    historyPanel.querySelector('[data-history-title]')!.textContent = `${city.name}: a new chapter for 2026.`;
    historyPanel.querySelector('[data-history-copy]')!.textContent = story?.story ?? 'Every city has a story. Every season brings another reason to believe.';
    const stats = historyPanel.querySelector('[data-history-stats]')!;
    stats.textContent = '';
    const row = document.createElement('div');
    const title = document.createElement('dt');
    const value = document.createElement('dd');
    title.textContent = 'Championship history';
    value.className = 'title-years';
    value.textContent = record?.verified && record.state === 'previous_winner' ? `Most recent title season: ${record.lastWinSeason}` : record?.verified && record.state === 'never_won' ? 'Still chasing a first title in the modern championship game.' : 'A city with its own football story.';
    row.append(title, value); stats.append(row);
    historyPanel.querySelector('[data-history-source]')!.textContent = record?.verified ? 'Championship history checked October 10, 2026. Seasons shown, not championship game dates.' : '';
    historyPanel.querySelector('[data-history-slogan]')!.textContent = `New season. ${city.name} colors. This is OUR year.`;
  }
  homePicker?.addEventListener('picker:change', (event) => updateHistory((event as CustomEvent).detail.slug));
  updateHistory(new URLSearchParams(location.search).get('city') ?? 'dallas');

  // A campaign message only shows when a campaign has been switched on.
  loadPublicState().then((state) => {
    const el = document.querySelector<HTMLElement>('[data-campaign]');
    if (!el) return;
    if (state?.campaign?.heroLine) {
      el.textContent = `${state.campaign.heroTitle} ${state.campaign.heroLine}`;
      el.hidden = false;
    } else if (state?.bandwagon?.verified && state.bandwagon.slugs?.length) {
      // Playoff time, and the picture is confirmed: point at the survivors.
      const n = state.bandwagon.slugs.length;
      const link = document.createElement('a');
      link.href = '/bandwagon/';
      link.textContent = 'Pick a survivor';
      el.textContent = `Still alive: ${n} ${n === 1 ? 'city' : 'cities'}. Room on the bandwagon. `;
      el.append(link);
      el.hidden = false;
    }
  });

  // Approved fan photos, if there are any yet.
  loadFanPhotos(6).then((photos) => {
    const strip = document.querySelector<HTMLElement>('[data-fan-strip]');
    const list = document.querySelector<HTMLElement>('[data-fan-list]');
    if (strip && list && photos.length) {
      renderFanList(list, photos);
      strip.hidden = false;
    }
  });
</script>

<style>
  .hero {
    padding-block: 28px 32px;
    text-align: center;
    /* The lettering takes these the same way a city page's shirt does. */
    --shirt: #1b1e23;
    --border: #1b1e23;
    --line1: #ffffff;
    --line2: #c3c9d0;
    --outline: #ffffff;
    background:
      linear-gradient(180deg, transparent, #062b18e6),
      repeating-linear-gradient(90deg, #ffffff09 0 10%, #ffffff00 10% 20%),
      linear-gradient(125deg, #307849, #165c32);
    border-top: 1px solid #ffffff12;
  }
  :global(body:has(.hero) .site-head) {
    border-top: 4px solid #c3c9d0;
  }
  .hero-kicker {
    margin: 0 0 16px;
    color: #d7dbe0;
    font: 400 clamp(0.875rem, 2vw, 1.125rem) / 1.5 var(--display);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .hero-actions .btn {
    min-height: 56px;
    background: #c3c9d0;
    color: #171a1f;
    border-color: #c3c9d0;
  }
  .hero-actions .btn:hover {
    background: #e4e7ea;
  }
  .hero-actions .btn-quiet {
    background: transparent;
    color: #fff;
    border-color: #8a9099;
  }
  .hero-actions .btn-quiet:hover {
    background: #ffffff12;
  }
  .hero-actions a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }
  @media (max-width: 440px) {
    .hero-kicker {
      font-size: 0.8125rem;
      letter-spacing: 0.08em;
    }
  }
  .campaign {
    display: inline-block;
    margin: 0 auto 22px;
    padding: 8px 14px;
    border-radius: 4px;
    background: var(--on-bg);
    color: var(--bg);
    font-weight: 600;
  }
  .campaign[hidden] {
    display: none;
  }
  .hero h1 {
    margin: 0 auto;
    max-width: 640px;
  }
  .hero-letters {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero-line {
    margin: 18px auto 26px;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--soft);
  }
  .hero-line span {
    display: block;
    text-wrap: balance;
  }
  .hero-line span:first-child {
    color: var(--on-bg);
    font-weight: 600;
  }
  .hero-actions {
    display: grid;
    gap: 10px;
    max-width: 420px;
    margin-inline: auto;
  }

  .find {
    padding-block: 36px 8px;
    scroll-margin-top: 8px;
    border-top: 1px solid var(--rule);
  }

  .ways {
    margin-top: 48px;
    padding-block: 40px;
    background: color-mix(in srgb, #000 22%, var(--bg));
  }
  .ways h2,
  .cities h2,
  .fans h2,
  .how h2 {
    font-size: clamp(1.375rem, 5.4vw, 2rem);
    margin-bottom: 22px;
  }
  .ways ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .ways li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 14px;
    align-items: baseline;
    padding: 14px 16px;
    border-bottom: 1px solid var(--rule);
    border-left: 3px solid #c3c9d0;
  }
  .ways li:nth-child(3n + 2) {
    border-left-color: #55b5de;
  }
  .ways li:nth-child(3n) {
    border-left-color: #b7a1e4;
  }
  .ways a {
    font-weight: 600;
    font-size: 1.25rem;
  }
  .ways .note {
    font-size: 0.9375rem;
    color: var(--soft);
    text-align: right;
  }
  .ways p {
    grid-column: 1 / -1;
    color: var(--soft);
  }

  .cities {
    padding-block: 48px 0;
    scroll-margin-top: 8px;
  }

  .fans {
    padding-block: 48px 0;
  }
  .fans[hidden] {
    display: none;
  }

  .how {
    margin-top: 64px;
    padding-block: 44px;
    background: color-mix(in srgb, #000 22%, var(--bg));
  }
  .how ol {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 26px;
  }
  .how li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 44px 1fr;
    column-gap: 14px;
    align-items: start;
  }
  .how li::before {
    color: #c3c9d0;
    content: counter(step);
    grid-row: span 2;
    font: 400 2.5rem/1 var(--display);
  }
  .how h3 {
    font: 600 1.25rem/1.25 var(--body);
  }
  .how p {
    color: var(--soft);
  }

  @media (min-width: 720px) {
    .hero {
      padding-block: 40px 44px;
    }
    .hero-line {
      font-size: 1.375rem;
    }
    .hero-actions {
      max-width: 420px;
    }
    .ways ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
      border-top: 0;
    }
    .ways li {
      border-top: 1px solid var(--rule);
      border-bottom: 0;
      align-content: start;
    }
    .how ol {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }

  .hero-secondary { padding: 8px; font-size: 1rem; }
  .find-intro { color: #d7dbe0; margin-bottom: 18px; font-weight: 600; }
  .browse-link { margin-top: 22px; }
  .ways ul { gap: 14px; border: 0; }
  .ways li { display: block; padding: 0; border: 1px solid var(--rule); border-radius: 6px; background: var(--panel); }
  .ways li a { display: flex; flex-direction: column; height: 100%; padding: 22px; text-decoration: none; }
  .ways li a:hover { background: #ffffff08; }
  .ways .note { text-align: left; color: #d7dbe0; margin-bottom: 8px; }
  .way-title { font-size: 1.5rem; line-height: 1.2; }
  .way-line { color: var(--soft); font-size: 1.0625rem; font-weight: 400; margin-block: 10px 18px; }
  .way-go { margin-top: auto; text-decoration: underline; font-size: 1rem; }
  .cities h2 { margin-bottom: 18px; }
  .featured { list-style: none; margin: 0 0 22px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .featured a { display: block; text-decoration: none; color: var(--on-bg); }
  .featured .tile { display: block; padding: 6px; border-radius: 6px; background: #fff; }
  .featured .tile :global(.shirt) { display: block; width: 100%; height: auto; }
  .featured .city { display: block; margin-top: 6px; font-weight: 600; font-size: 0.9375rem; }
  .featured a:hover .city { text-decoration: underline; }
  @media (min-width: 720px) {
    .featured { grid-template-columns: repeat(6, 1fr); }
  }
  .cities summary { cursor: pointer; padding: 18px 0; font-size: 1.5rem; font-weight: 600; border-block: 1px solid var(--rule); }
  .cities summary span { display: block; color: var(--soft); font-size: 1rem; font-weight: 400; }
  .cities details[open] summary { margin-bottom: 24px; }
  .worn { padding-top: 48px; }
  .worn h2 { font-size: clamp(1.375rem, 5.4vw, 2rem); }
  .worn :global(.hero-models) { max-width: 560px; margin: 22px 0 0; }
  .worn .concept { max-width: 560px; }
  .worn-link { margin-top: 18px; }
  @media (max-width: 859px) {
    .find :global(.stage.is-neutral .stage-empty) { aspect-ratio: auto; min-height: 100px; padding: 20px; }
    .find :global(.stage.is-neutral .stage-empty p) { max-width: none; }
    .find :global(.picker-stage:has(.is-neutral) .concept) { display: none; }
  }
</style>

<style>
  .hero {background:repeating-linear-gradient(90deg,transparent 0 119px,#ffffff03 120px 240px),linear-gradient(135deg,#184c34,#082c20);text-align:left;padding:64px 0;--line1:#fff;--line2:#c3c9d0;--outline:#e8e8dc;--shirt:#143d29}
  .hero-layout {display:grid;grid-template-columns:1.05fr 1fr;gap:72px;align-items:center}
  .eyebrow {font:600 .8rem/1.4 var(--body);text-transform:uppercase;letter-spacing:.18em;color:#efbd32;margin:0 0 22px}
  .hero h1 {margin:0;max-width:560px}.hero-letters{width:100%;filter:drop-shadow(0 5px 0 #0002)}
  .hero-tagline{font-size:1.65rem;font-weight:600;margin:24px 0 8px;color:#fff}.hero-description{font-size:1.2rem;line-height:1.5;color:#c4d4c7;max-width:390px}
  .hero-actions{display:flex;align-items:center;gap:28px;margin:28px 0 22px;max-width:none}.hero-actions .btn{background:#f4bd00;color:#10251c;border-color:#f4bd00;gap:32px;display:flex;align-items:center}.hero-link{color:#fff;font-weight:600;text-underline-offset:6px}
  .hero-details{font-size:.94rem;color:#c4d4c7}.hero-details span{padding:0 9px}
  .hero-product{background:#f7f7f1;border-radius:4px;color:#19291f;padding:20px 24px 14px;transform:rotate(2deg);box-shadow:0 22px 55px #001b2240}
  .product-heading{display:flex;justify-content:space-between;text-transform:uppercase;letter-spacing:.1em;font-size:.73rem;font-weight:600}.featured-shirt{display:block;background:#fff;margin:16px 0 10px}.featured-shirt :global(.shirt){display:block;width:100%;max-height:390px}
