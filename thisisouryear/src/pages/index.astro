---
import Layout from '../layouts/Layout.astro';
import Shirt from '../components/Shirt.astro';
import Lettering from '../components/Lettering.astro';
import teams from '../data/teams.json';
import product from '../data/product.json';
import { dollars } from '../lib/money.js';
import { styleString } from '../lib/colors.js';

const cities = [...teams].sort((a, b) => a.name.localeCompare(b.name));
const price = dollars(product.priceCents);

const shirtColors = (t) =>
  styleString({ '--shirt': t.shirt, '--line1': t.line1, '--line2': t.line2, '--outline': t.outline });

// What the search box matches against: the city name plus any nearby places
// listed under "aka" in teams.json.
const searchText = (t) => [t.name, ...(t.aka ?? [])].join(' ').toLowerCase();
---

<Layout
  description={`Every fan says it every season. Now wear it in your city's colors. One tee, ${cities.length} colorways, ${price}.`}
  navHref="#cities"
>
  <section class="hero">
    <div class="wrap">
      <h1>
        <span class="sr-only">This Is Our Year</span>
        <svg class="hero-letters" viewBox="0 0 620 232" aria-hidden="true">
          <Lettering x={310} y={91} size={100} />
        </svg>
      </h1>
      <p class="hero-line">
        <span>You said it last season. And the one before.</span>
        <span>Say it again, in your city's colors.</span>
      </p>
      <a class="btn" href="#cities">Pick your city</a>
    </div>
  </section>

  <section class="cities" id="cities" aria-labelledby="cities-h">
    <div class="wrap">
      <div class="cities-head">
        <h2 id="cities-h">{cities.length} cities. One tee. {price}.</h2>
        <div class="search">
          <label for="city-search">Find your city</label>
          <input
            id="city-search"
            type="search"
            placeholder="Start typing a city"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            aria-controls="city-grid"
          />
        </div>
      </div>

      <ul class="grid" id="city-grid">
        {
          cities.map((t) => (
            <li data-search={searchText(t)}>
              <a href={`/${t.slug}/`} style={shirtColors(t)}>
                <span class="tile">
                  <Shirt team={t} decorative />
                </span>
                <span class="city">{t.name}</span>
                <span class="colors">{t.colors}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="no-match" id="no-match" role="status" hidden>
        No city by that name. Try a nearby city or your state.
        <button type="button" id="clear-search">Show all {cities.length}</button>
      </p>
    </div>
  </section>

  <section class="how" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h">How it works</h2>
      <ol>
        <li>
          <h3>Pick your city</h3>
          <p>Same shirt, same four words, your colors.</p>
        </li>
        <li>
          <h3>Pick your size</h3>
          <p>S through 3XL. Checkout takes about a minute.</p>
        </li>
        <li>
          <h3>We print and ship</h3>
          <p>Printed when you order and mailed to your door, in plenty of time to be wrong again.</p>
        </li>
      </ol>
    </div>
  </section>
</Layout>

<script>
  const input = document.getElementById('city-search') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#city-grid > li'));
  const empty = document.getElementById('no-match');
  const clear = document.getElementById('clear-search');

  function filter() {
    const q = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const hit = !q || (li.dataset.search ?? '').includes(q);
      li.hidden = !hit;
      if (hit) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  }

  input?.addEventListener('input', filter);
  clear?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
    }
    filter();
  });
  // Browsers sometimes restore the typed text when you come back to the page.
  filter();
</script>

<style>
  .hero {
    padding-block: 36px 44px;
    text-align: center;
  }
  .hero h1 {
    margin: 0 auto;
    max-width: 640px;
  }
  .hero-letters {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero-line {
    margin: 18px auto 26px;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--soft);
  }
  .hero-line span {
    display: block;
    text-wrap: balance;
  }

  .cities {
    padding-block: 28px 0;
    scroll-margin-top: 8px;
  }
  .cities-head {
    display: grid;
    gap: 18px;
    margin-bottom: 22px;
  }
  .cities-head h2 {
    font-size: clamp(1.375rem, 5.4vw, 2rem);
  }
  .search label {
    display: block;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .search input {
    width: 100%;
    min-height: 52px;
    padding: 0 16px;
    border: 2px solid var(--edge);
    border-radius: 4px;
    background: var(--panel);
    color: var(--on-bg);
    font: 400 1.125rem/1 var(--body);
  }
  .search input::placeholder {
    color: var(--soft);
    opacity: 1;
  }
  .search input:focus-visible {
    outline: none;
    border-color: var(--on-bg);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 14px;
  }
  .grid li[hidden] {
    display: none;
  }
  .grid a {
    display: block;
    text-decoration: none;
  }
  .tile {
    display: block;
    padding: 10px;
    border-radius: 6px;
    background: var(--tile);
  }
  .tile :global(.shirt) {
    transition: transform 0.18s ease-out;
  }
  .grid a:hover .tile :global(.shirt),
  .grid a:focus-visible .tile :global(.shirt) {
    transform: scale(1.05);
  }
  .city {
    display: block;
    margin-top: 9px;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.2;
  }
  .grid a:hover .city {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .colors {
    display: block;
    margin-top: 2px;
    font-size: 0.9375rem;
    color: var(--soft);
  }

  .no-match {
    padding: 28px 0 8px;
    font-size: 1.125rem;
  }
  .no-match[hidden] {
    display: none;
  }
  .no-match button {
    display: block;
    margin-top: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: 600 1.125rem/1.4 var(--body);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .how {
    margin-top: 64px;
    padding-block: 44px;
    background: color-mix(in srgb, #000 22%, var(--bg));
  }
  .how h2 {
    font-size: clamp(1.375rem, 5.4vw, 2rem);
    margin-bottom: 24px;
  }
  .how ol {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 26px;
  }
  .how li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 44px 1fr;
    column-gap: 14px;
    align-items: start;
  }
  .how li::before {
    content: counter(step);
    grid-row: span 2;
    font: 400 2.5rem/1 var(--display);
  }
  .how h3 {
    font: 600 1.25rem/1.25 var(--body);
  }
  .how p {
    color: var(--soft);
  }

  @media (min-width: 720px) {
    .hero {
      padding-block: 56px 60px;
    }
    .hero-line {
      font-size: 1.375rem;
    }
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 30px 18px;
    }
    .cities-head {
      grid-template-columns: 1fr minmax(260px, 340px);
      align-items: end;
    }
    .how ol {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
  @media (min-width: 1000px) {
    .grid {
      gap: 38px 24px;
    }
    .tile {
      padding: 14px;
    }
  }
</style>
