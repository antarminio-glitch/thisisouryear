---
// Real measurements from the maker's spec sheets (src/data/specs.json), for
// every garment that is for sale. Garments not for sale yet are listed so
// nobody wonders, but get no chart until they can be bought.
import Layout from '../layouts/Layout.astro';
import catalog from '../data/catalog.json';
import specs from '../data/specs.json';
import { shop } from '../lib/shop.js';

const products = catalog.products.map((p) => ({ product: p, spec: specs.products[p.id] ?? null, sellable: shop.isSellable(p) }));
const forSale = products.filter((x) => x.sellable);
const notYet = products.filter((x) => !x.sellable);

const inches = (n) => (n == null ? 'Not listed' : `${String(n).replace(/\.0+$/, '')} in`);
const sizesOf = (p) => p.variants.map((v) => v.size);
const describe = forSale.map((x) => `${x.product.name.toLowerCase()} ${sizesOf(x.product)[0]} to ${sizesOf(x.product).at(-1)}`).join(', ');
---

<Layout title="Size chart" description={`Real measurements from the maker for every This Is Our Year garment: ${describe}.`}>
  <div class="wrap page">
    <div class="prose">
      <h1>Size chart</h1>
      <p class="lede">
        These are the maker's own numbers, measured flat, not estimates. Between sizes? Go up if you like room, down if you
        like it snug.
      </p>

      {
        forSale.map(({ product, spec }) => (
          <section aria-labelledby={`${product.id}-h`}>
            <h2 id={product.id}>{product.name}</h2>
            {spec ? (
              <>
                <p>
                  {spec.fabric}. {spec.fit}. {spec.features.join('. ')}.
                </p>
                <div class="table-scroll">
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Size</th>
                        {product.audience === 'kids' && <th scope="col">Ages</th>}
                        <th scope="col">Chest width, flat</th>
                        <th scope="col">Length</th>
                        <th scope="col">Fits a chest of</th>
                      </tr>
                    </thead>
                    <tbody>
                      {sizesOf(product).map((size) => {
                        const m = spec.measurements[size];
                        return (
                          <tr>
                            <th scope="row">{size}</th>
                            {product.audience === 'kids' && <td>{m?.ages ?? ''}</td>}
                            <td>{m ? inches(m.chest) : 'Ask us'}</td>
                            <td>{m ? inches(m.length) : 'Ask us'}</td>
                            <td>{m?.fitsChest ? `${m.fitsChest} in` : ''}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
                <p class="hint">
                  Care: {spec.care} Maker's style {spec.style}. <a href={spec.specSheet} rel="noopener noreferrer" target="_blank">The maker's spec sheet</a> lists every size they make.
                </p>
              </>
            ) : (
              <p>Measurements are on the way. Email us if you need them before then.</p>
            )}
          </section>
        ))
      }

      {
        notYet.length > 0 && (
          <section aria-labelledby="not-yet-h">
            <h2 id="not-yet-h">Not for sale yet</h2>
            <p>{notYet.map((x) => x.product.name).join(', ')}. The chart goes up here the day it goes on sale.</p>
          </section>
        )
      }

      <h2>How to measure</h2>
      <p>
        Grab a shirt that fits you well and lay it flat. Chest width is straight across, one inch below the armpits. Length
        is from the top of the shoulder by the collar down to the bottom hem. "Fits a chest of" is your own chest, measured
        under the arms around the fullest part with the tape level.
      </p>

      <p class="actions"><a class="btn" href="/teams/">Pick your city</a></p>
    </div>
  </div>
</Layout>
