---
// The city page. This one file becomes all 32 pages, one per entry in
// src/data/teams.json.
import Layout from '../layouts/Layout.astro';
import Picker from '../components/Picker.astro';
import ShopData from '../components/ShopData.astro';
import ModelShot from '../components/ModelShot.astro';
import ThisWeek from '../components/ThisWeek.astro';
import teams from '../data/teams.json';
import models from '../data/model-photos.json';
import photos from '../data/garment-photos.json';
import { modelPhotoForCity } from '../lib/photos.js';
import store from '../data/store.json';
import history from '../data/history.json';
import stories from '../data/stories.json';
import season from '../data/season-2026.json';
import palettes from '../data/palettes.json';
import { shop } from '../lib/shop.js';
import { dollars } from '../lib/shop-core.js';
import { themeFor, styleString } from '../lib/colors.js';
import { placeName } from '../lib/cities.js';
import { counterFor, todayIn } from '../lib/counter.js';
import { cardPath, cardAlt } from '../lib/og.js';
import { productJsonLd, sellableStyles } from '../lib/seo.js';
import specs from '../data/specs.json';

export function getStaticPaths() {
  return teams.map((team) => ({ params: { slug: team.slug }, props: { team } }));
}

const { team } = Astro.props;
const theme = themeFor(team);

// What the tee is, from the maker's spec sheet. The block starts on the tee
// and follows the picker in the browser (see the script at the bottom).
const tee = specs.products['adult-tee'];

// One small on-model thumbnail, only when a blank this city is printed on
// has a model shot. Most cities have none, and then nothing extra shows.
const modelShot = modelPhotoForCity(models, photos, team.slug);
const modelGarment = modelShot ? (shop.product(modelShot.productId)?.name ?? 'Shirt') : '';
const place = placeName(team);
const story = stories[team.slug];
// The 2026 season layer: a slogan for every city, verified history for some.
const seasonCity = season.cities[team.slug] ?? {};
const seasonHistory = seasonCity.history?.verified === true && Array.isArray(seasonCity.history.facts) && seasonCity.history.facts.length > 0 ? seasonCity.history : null;

// The counter is worked out when the site is built, then re-checked in the
// browser with today's date, so it's right even if the build is a day old.
const today = todayIn(store.timezone);
const counter = counterFor(team.slug, place, history, today);
const card = cardPath(team, counter.text, undefined, palettes.version);
const cardDescription = cardAlt(team, counter.text);

const range = shop.priceRange('adult-tee');
const styles = sellableStyles(shop);
const styleWords = styles.length ? styles.join(' and ') : 'Tee';
const title = `This Is Our Year ${styleWords} in ${team.name} Colors, ${team.colors}`;
const priceLine = range ? `${dollars(range.lowCents)}, printed to order.` : 'Printed to order.';
const description = `${story.headline} The This Is Our Year ${styleWords.toLowerCase()} in ${place} colors, ${team.colors}. ${priceLine}`;

const pageUrl = new URL(`/${team.slug}/`, Astro.site).href;
const structuredData = productJsonLd(team, shop, {
  siteUrl: Astro.site.href,
  pageUrl,
  imageUrl: new URL(card, Astro.site).href,
  description,
});

// What the browser needs to re-check the counter. Nothing but this city.
const counterData = {
  slug: team.slug,
  place,
  timezone: store.timezone,
  history: { latestCompletedSeason: history.latestCompletedSeason, refreshBy: history.refreshBy, cities: { [team.slug]: history.cities[team.slug] } },
};
---

<Layout title={title} description={description} theme={styleString(theme)} themeColor={team.shirt} image={card} imageAlt={cardDescription} structuredData={structuredData}>
  <ShopData />

  <aside class="wait" aria-label="How long it's been" data-wait>
    <div class="wrap">
      <p class="wait-kicker">{season.banner.kicker} · {place}</p>
      <p class="wait-big" data-wait-big>{counter.banner.big}</p>
      <p class="wait-line" data-wait-line>{counter.banner.line}</p>
      <ThisWeek city={team.slug} />
    </div>
  </aside>

  <div class="wrap city">
    <Picker city={team} lockCity buyNow id="city">
      <div slot="intro" class="intro">
        <h1>This is our year, {place}.</h1>
        <p class="colorway">{team.colors}</p>
        <p class="season-tag"><span class="season-kicker">{season.banner.kicker}</span> {seasonCity.slogan ?? season.banner.line}</p>
      </div>
      {
        modelShot && (
          <ModelShot
            slot="stage-extra"
            class="model-thumb"
            photo={modelShot}
            team={team}
            label={`${modelGarment} in ${team.name} colors, on a model`}
            caption={`On a model: the ${modelGarment.toLowerCase()} in ${modelShot.name}`}
          />
        )
      }
    </Picker>
  </div>

  <div class="wrap city-more">
    <section class="story" aria-labelledby="story-h">
      <h2 id="story-h">{story.headline}</h2>
      <p>{story.story}</p>
      <p class="occasion">{story.occasion}</p>
    </section>

    {
      seasonHistory && (
        <section class="history" aria-labelledby="history-h">
          <h2 id="history-h">How {place} got here</h2>
          <ul>
            {seasonHistory.facts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
          <p class="hint">Checked {seasonHistory.verifiedOn}. {seasonHistory.source}</p>
        </section>
      )
    }

    <section class="drought" aria-labelledby="drought-h" data-counter={JSON.stringify(counterData)}>
      <h2 id="drought-h" class="sr-only">How long it's been</h2>
      <p class="drought-line" data-counter-text>{counter.text}</p>
      <p class="hint" data-counter-context hidden={!counter.context}>{counter.context}</p>
      <figure class="card">
        <img src={card} alt={cardDescription} width="1200" height="630" loading="lazy" decoding="async" />
        <figcaption class="sr-only">Share card for {team.name}</figcaption>
      </figure>
      <div class="share" data-share data-url={pageUrl} data-title={`This is our year, ${place}.`} data-text={`${counter.text} ${store.hashtag}`} data-city={team.slug}>
        <a class="btn" href={card} download={`this-is-our-year-${team.slug}.png`} data-share-download>Download the card</a>
        <button class="btn btn-quiet" type="button" data-share-native hidden>Share</button>
        <button class="btn btn-quiet" type="button" data-share-copy>Copy the link</button>
      </div>
      <p class="hint" data-share-msg role="status" hidden></p>
      <p class="hint">Post it with {store.hashtag}. Then <a href="/fans/">send us your photo</a>.</p>
    </section>

    <section class="also" aria-labelledby="also-h">
      <h2 id="also-h">More ways to wear {place} colors</h2>
      <ul>
        <li>
          <a href={`/gifts/rival-colors/?wear=${team.slug}`}>Make a rival wear them</a>
          <span>A thoughtful gift. For a terrible friend.</span>
        </li>
        <li>
          <a href={`/fantasy-leagues/?city=${team.slug}`}>Last place wears them</a>
          <span>Punishment shirts for your fantasy league, in mixed sizes.</span>
        </li>
        <li>
          <a href={`/matching-sets/?city=${team.slug}`}>Match with a kid</a>
          <span>One adult item, one kids item, same colors.</span>
        </li>
      </ul>
    </section>

    <section class="details-block" aria-labelledby="details-h" data-about>
      <h2 id="details-h">About the <span data-about-name>tee</span></h2>
      <dl class="details">
        <div>
          <dt>Fabric</dt>
          <dd data-about-fabric>{tee.fabric}</dd>
        </div>
        <div>
          <dt>Fit</dt>
          <dd><span data-about-fit>{tee.fit}</span>. <a href="/size-chart/#adult-tee" data-about-chart>Size chart</a></dd>
        </div>
        <div>
          <dt>Care</dt>
          <dd data-about-care>{tee.care}</dd>
        </div>
        <div>
          <dt>Print</dt>
          <dd>Printed to order in {team.colors}</dd>
        </div>
        <div>
          <dt>Shipping</dt>
          <dd>
            {dollars(store.shippingCents)} flat in the US. Arrives in about {store.shipMinDays} to {store.shipMaxDays} business days.
          </dd>
        </div>
      </dl>
      <p class="hint">You pay on Stripe's secure checkout page.</p>
    </section>

    <p class="other"><a href="/teams/">Not your city? Pick another</a></p>
  </div>
</Layout>

<script>
  // The "About" block follows whatever garment the picker shows: tee, hoodie
  // or kids tee. The text comes from the same specs the size chart uses.
  import { data } from '../scripts/shop-data.js';

  const about = document.querySelector<HTMLElement>('[data-about]');
  const specs = (data as { specs?: Record<string, { fabric: string; fit: string; care: string }> }).specs ?? {};
  document.addEventListener('picker-change', (e) => {
    const { product } = (e as CustomEvent).detail as { product: { id: string; name: string; sizeChart?: string } };
    const spec = specs[product.id];
    if (!about || !spec) return;
    const set = (sel: string, text: string) => {
      const el = about.querySelector(sel);
      if (el) el.textContent = text;
    };
    set('[data-about-name]', product.name.toLowerCase());
    set('[data-about-fabric]', spec.fabric);
    set('[data-about-fit]', spec.fit);
    set('[data-about-care]', spec.care);
    const chart = about.querySelector<HTMLAnchorElement>('[data-about-chart]');
    if (chart) {
      chart.hidden = !product.sizeChart;
      if (product.sizeChart) chart.href = product.sizeChart;
    }
  });
</script>

<script>
  import { counterFor, todayIn } from '../lib/counter.js';
  import { track } from '../scripts/analytics.js';

  // Re-check the counter against today's date in the store's timezone.
  const box = document.querySelector<HTMLElement>('[data-counter]');
  if (box) {
    try {
      const d = JSON.parse(box.dataset.counter ?? '{}');
      const now = counterFor(d.slug, d.place, d.history, todayIn(d.timezone));
      const text = box.querySelector('[data-counter-text]');
      const context = box.querySelector<HTMLElement>('[data-counter-context]');
      if (text && text.textContent !== now.text) text.textContent = now.text;
      const big = document.querySelector('[data-wait-big]');
      const line = document.querySelector('[data-wait-line]');
      if (big && big.textContent !== now.banner.big) big.textContent = now.banner.big;
      if (line && line.textContent !== now.banner.line) line.textContent = now.banner.line;
      if (context) {
        context.textContent = now.context;
        context.hidden = !now.context;
      }
    } catch {
      /* keep the text the page was built with */
    }
  }

  // Share card: download, native share where the device has it, or copy the link.
  const share = document.querySelector<HTMLElement>('[data-share]');
  if (share) {
    const msg = document.querySelector<HTMLElement>('[data-share-msg]');
    const say = (t: string) => {
      if (msg) {
        msg.textContent = t;
        msg.hidden = !t;
      }
    };
    const { url = location.href, title = document.title, text = '', city = '' } = share.dataset;
    const native = share.querySelector<HTMLButtonElement>('[data-share-native]');
    if (native && typeof navigator.share === 'function') {
      native.hidden = false;
      native.addEventListener('click', async () => {
        try {
          await navigator.share({ title, text, url });
          track('share_card_downloaded', { team_id: city, method: 'native_share' });
        } catch {
          /* the person closed the share sheet */
        }
      });
    }
    share.querySelector('[data-share-download]')?.addEventListener('click', () => {
      track('share_card_downloaded', { team_id: city, method: 'download' });
    });
    share.querySelector('[data-share-copy]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        say('Link copied.');
      } catch {
        say(`Copy this link: ${url}`);
      }
      track('share_card_downloaded', { team_id: city, method: 'copy_link' });
    });
  }
</script>

<style>
  .city {
    padding-block: 20px 8px;
  }
  .city-more {
    display: grid;
    gap: 44px;
    padding-block: 28px 72px;
    max-width: 860px;
  }
  h1 {
    font-size: clamp(1.75rem, 7.4vw, 2.75rem);
  }
  .intro {
    margin-bottom: 18px;
  }
  .wait {
    padding: 18px 0 20px;
    background: var(--accent);
    color: var(--on-accent);
  }
  .wait .wrap {
    padding-block: 0;
  }
  .wait-kicker {
    font: 400 0.875rem / 1.4 var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .wait-big {
    margin-top: 4px;
    font: 400 clamp(2.75rem, 13vw, 5.5rem) / 1 var(--display);
    text-transform: uppercase;
  }
  .wait-line {
    margin-top: 8px;
    max-width: var(--read);
    font-size: 1.125rem;
    text-wrap: balance;
  }
  .colorway {
    margin-top: 8px;
    font-size: 1.25rem;
    color: var(--soft);
  }
  .story h2 {
    font-size: clamp(1.25rem, 5vw, 1.75rem);
  }
  .story p {
    margin-top: 10px;
    max-width: var(--read);
  }
  .occasion {
    color: var(--soft);
  }

  .drought {
    display: grid;
    gap: 14px;
    padding: 22px;
    border-radius: 8px;
    background: var(--panel);
  }
  .drought-line {
    font: 400 clamp(1.375rem, 5.6vw, 2rem) / 1.2 var(--display);
    text-wrap: balance;
  }
  .card {
    margin: 4px 0 0;
  }
  .card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--rule);
  }
  .share {
    display: grid;
    gap: 10px;
  }
  .share .btn {
    width: 100%;
  }
  .share .btn[hidden] {
    display: none;
  }

  .also h2,
  .details-block h2 {
    font-size: 1.25rem;
    margin-bottom: 14px;
  }
  .also ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .also li {
    display: grid;
    gap: 2px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }
  .also a {
    font-weight: 600;
    font-size: 1.1875rem;
  }
  .also span {
    color: var(--soft);
  }

  .details {
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .details div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .details dt {
    font-weight: 600;
  }
  .details dd {
    margin: 0;
  }
  .other {
    font-weight: 600;
  }

  @media (min-width: 620px) {
    .share {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 860px) {
    .city {
      padding-block: 40px 16px;
    }
  }
</style>

<style>
  .season-tag {
    margin: 8px 0 0;
    color: var(--soft);
  }
  .season-tag .season-kicker {
    display: inline-block;
    margin-right: 8px;
    padding: 2px 8px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font: 400 0.8125rem / 1.5 var(--display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-bg);
  }
  .history {
    margin-top: 36px;
  }
  .history h2 {
    font-size: clamp(1.375rem, 5.4vw, 2rem);
    margin-bottom: 14px;
  }
  .history ul {
    margin: 0 0 12px;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }
</style>
